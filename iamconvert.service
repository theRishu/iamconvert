[Unit]
Description=IamConvert Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/botsrc/iamconvert
ExecStart=/usr/bin/python3.14 main.py
Restart=always
RestartSec=5
# Uncomment the line below if you want to load env vars from a file explicitly
# EnvironmentFile=/root/botsrc/iamconvert/.env

[Install]
WantedBy=multi-user.target
